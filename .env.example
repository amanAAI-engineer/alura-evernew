# Copy these into your environment (or set them in your hosting dashboard).
# Company details shown in footer, contact page and invoices
COMPANY_NAME="ALURA Services Pvt. Ltd."
COMPANY_ADDRESS="Street, City, State, PIN"
COMPANY_GSTIN="22AAAAA0000A1Z5"
COMPANY_STATE="Uttar Pradesh"        # for CGST/SGST vs IGST on invoices
SUPPORT_PHONE="+91 00000 00000"
SUPPORT_EMAIL="support@example.com"
SUPPORT_HOURS="Mon-Sat, 10am-6pm"
# Store behaviour
GST_RATE=18
FREE_SHIPPING_ABOVE_RUPEES=999
COD_ENABLED=true
PAYMENT_MODE=demo
# Admin (/admin). If unset, a random password is generated on first run and printed.
ADMIN_PASSWORD=
SECRET_KEY=
# Optional email (otherwise emails are only logged in the outbox table)
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Deployment (docker compose) ---
DOMAIN=yourdomain.com
